  "components": [
    {
      "name": "Banda de encabezado",
      "kind": "custom",
      "refersTo": "header-band",
      "description": "Franja de rojo óxido a sangre con el título de la pantalla; una por pantalla.",
      "html": "<header class=\"ds-band\"><h1>Taller: cortes de barras</h1><p>barras 6 m · disco 3 mm</p></header>",
      "css": ".ds-band{background:var(--band,#8A2E21);color:var(--on-band,#FFF4F0);padding:16px 14px 14px;font-family:var(--font,'Archivo',system-ui,sans-serif);}.ds-band h1{margin:0;font-size:19px;font-weight:900;font-stretch:110%;text-transform:uppercase;letter-spacing:.01em;line-height:1.05}.ds-band p{margin:4px 0 0;font-size:12.5px;font-stretch:92%;color:var(--on-band-mute,#F2CFC7)}"
    },
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de la pantalla, en óxido plano con sombra corta.",
      "html": "<button class=\"ds-btn-primary\">Terminé de cortar</button>",
      "css": ".ds-btn-primary{font-family:var(--font,'Archivo',system-ui,sans-serif);background:var(--accent,#8A2E21);color:var(--accent-ink,#FFFFFF);border:1.5px solid var(--accent-dark,#5E1D14);border-radius:8px;padding:10px 14px;min-height:42px;font-size:14px;font-weight:800;font-stretch:95%;box-shadow:0 1px 2px rgba(94,29,20,.35);transition:transform .08s ease-out}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#8A2E21);outline-offset:2px}"
    },
    {
      "name": "Botón fantasma",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Acción secundaria: blanco con borde marcado, sin sombra.",
      "html": "<button class=\"ds-btn-ghost\">Cargar ejemplo del cuaderno</button>",
      "css": ".ds-btn-ghost{font-family:var(--font,'Archivo',system-ui,sans-serif);background:var(--card,#FFFFFF);color:var(--ink,#17191A);border:1.5px solid var(--line-strong,#9AA1A5);border-radius:8px;padding:10px 14px;min-height:42px;font-size:14px;font-weight:800;font-stretch:95%;transition:transform .08s ease-out}.ds-btn-ghost:active{transform:translateY(1px)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#8A2E21);outline-offset:2px}"
    },
    {
      "name": "Chips de paso",
      "kind": "nav",
      "refersTo": "step-chip-active",
      "description": "Pasos del Taller; el activo en óxido.",
      "html": "<div class=\"ds-steps\"><button class=\"ds-step\" aria-selected=\"true\"><b>1.</b> Cortes</button><button class=\"ds-step\"><b>2.</b> Plan y compra</button><button class=\"ds-step\"><b>3.</b> Retazos</button></div>",
      "css": ".ds-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;font-family:var(--font,'Archivo',system-ui,sans-serif);}.ds-step{border:0;background:var(--card,#FFFFFF);color:var(--muted,#545B60);border-radius:8px;min-height:38px;padding:7px 4px;font-size:12px;font-weight:800;font-stretch:86%;box-shadow:0 1px 2px rgba(23,25,26,.1)}.ds-step[aria-selected=\"true\"]{background:var(--band,#8A2E21);color:var(--on-band,#FFF4F0);box-shadow:none}.ds-step:focus-visible{outline:2px solid var(--accent,#8A2E21);outline-offset:2px}"
    },
    {
      "name": "Panel etiqueta",
      "kind": "card",
      "refersTo": "panel",
      "description": "Panel blanco sin borde con regla superior de 4 px y sombra corta.",
      "html": "<section class=\"ds-panel\"><h2>Obra o cliente</h2><p>Ej: Ventanas casa Pérez</p></section>",
      "css": ".ds-panel{font-family:var(--font,'Archivo',system-ui,sans-serif);background:var(--card,#FFFFFF);color:var(--ink,#17191A);border-top:4px solid var(--ink,#17191A);border-radius:6px;padding:12px;box-shadow:0 1px 2px rgba(23,25,26,.08),0 4px 10px -6px rgba(23,25,26,.18)}.ds-panel h2{margin:0 0 6px;font-size:16.5px;font-weight:850;font-stretch:82%;text-transform:uppercase;letter-spacing:.015em}.ds-panel p{margin:0;font-size:15px;font-weight:500;color:var(--muted,#545B60)}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "field",
      "description": "Campo sobre gris imprimación con borde marcado; foco en óxido.",
      "html": "<label class=\"ds-field\"><span>Ancho (mm)</span><input value=\"1200\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:5px;font-family:var(--font,'Archivo',system-ui,sans-serif);}.ds-field span{font-size:12px;font-weight:750;text-transform:uppercase;letter-spacing:.06em;font-stretch:92%;color:var(--muted,#545B60)}.ds-field input{font:inherit;background:var(--surface,#EEF0F1);color:var(--ink,#17191A);border:1.5px solid var(--line-strong,#9AA1A5);border-radius:10px;padding:8px 10px;font-size:14px;font-weight:600;font-stretch:85%;font-variant-numeric:tabular-nums;caret-color:var(--accent,#8A2E21)}.ds-field input:focus-visible{outline:2px solid var(--accent,#8A2E21);outline-offset:2px}"
    },
    {
      "name": "Ficha técnica",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Firma del Plan de corte: cabecera con regla negra y cuatro cifras separadas por hilos.",
      "html": "<div class=\"ds-spec\"><div class=\"ds-spec-h\"><h3>Caño estructural 80×40</h3><span>1,6 mm · $ 59.000 c/u</span></div><div class=\"ds-spec-g\"><div><small>Barras</small><b>4</b></div><div><small>Kilos</small><b>69,4</b></div><div><small>Pesos</small><b>236.000</b></div><div class=\"hot\"><small>Sobra</small><b>2,8 m</b></div></div></div>",
      "css": ".ds-spec{font-family:var(--font,'Archivo',system-ui,sans-serif);background:var(--card,#FFFFFF);color:var(--ink,#17191A);padding:0 12px 8px}.ds-spec-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding-top:10px;border-top:4px solid var(--ink,#17191A)}.ds-spec-h h3{margin:0;font-size:16.5px;font-weight:900;font-stretch:80%;text-transform:uppercase;letter-spacing:.01em}.ds-spec-h span{font-size:12px;color:var(--muted,#545B60);font-stretch:90%;white-space:nowrap}.ds-spec-g{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line,#CBD0D2);border-bottom:1px solid var(--line,#CBD0D2);margin-top:6px}.ds-spec-g>div{display:flex;flex-direction:column;padding:6px 8px 7px;border-left:1px solid var(--line,#CBD0D2)}.ds-spec-g>div:first-child{border-left:0;padding-left:0}.ds-spec-g small{font-size:10.5px;font-weight:750;letter-spacing:.07em;text-transform:uppercase;color:var(--muted,#545B60);font-stretch:90%}.ds-spec-g b{font-size:18px;font-weight:850;font-stretch:82%;font-variant-numeric:tabular-nums}.ds-spec-g .hot b{color:var(--accent,#8A2E21)}"
    },
    {
      "name": "Losa de total",
      "kind": "custom",
      "refersTo": "total-slab",
      "description": "Barra fija casi negra con el total y la acción principal.",
      "html": "<div class=\"ds-slab\"><div><small>8 barras</small><b>$ 332.800</b></div><button>Terminé de cortar</button></div>",
      "css": ".ds-slab{font-family:var(--font,'Archivo',system-ui,sans-serif);display:flex;align-items:center;gap:10px;background:var(--slab,#17191A);color:var(--on-slab,#F4F5F6);padding:9px 12px;box-shadow:0 -6px 16px -8px rgba(0,0,0,.4)}.ds-slab small{display:block;font-size:10.5px;font-weight:750;letter-spacing:.07em;text-transform:uppercase;color:#B9C0C3;font-stretch:90%}.ds-slab b{font-size:21px;font-weight:900;font-stretch:82%;font-variant-numeric:tabular-nums}.ds-slab button{margin-left:auto;font:inherit;font-size:13.5px;font-weight:800;background:var(--accent,#8A2E21);color:var(--accent-ink,#FFFFFF);border:1.5px solid var(--accent-dark,#5E1D14);border-radius:8px;min-height:42px;padding:8px 15px}.ds-slab button:active{transform:translateY(1px)}.ds-slab button:focus-visible{outline:2px solid var(--on-slab,#F4F5F6);outline-offset:2px}"
    },
    {
      "name": "Navegación inferior",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Cuatro destinos fijos abajo; el activo en óxido, sin fondo.",
      "html": "<nav class=\"ds-nav\"><a>Presupuestar</a><a aria-current=\"page\">Taller</a><a>Precios</a><a>Ajustes</a></nav>",
      "css": ".ds-nav{font-family:var(--font,'Archivo',system-ui,sans-serif);display:grid;grid-template-columns:repeat(4,1fr);gap:4px;background:var(--card,#FFFFFF);border-top:1px solid var(--line,#CBD0D2);padding:4px 8px}.ds-nav a{display:flex;align-items:center;justify-content:center;min-height:46px;font-size:11.5px;font-weight:700;font-stretch:92%;color:var(--muted,#545B60);text-decoration:none;cursor:pointer}.ds-nav a[aria-current=\"page\"]{color:var(--accent,#8A2E21);font-weight:850}.ds-nav a:focus-visible{outline:2px solid var(--accent,#8A2E21);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "La etiqueta de la lata de antióxido",
    "overview": "**Creative North Star: \"La etiqueta de la lata de antióxido\"**\n\nCada pantalla se lee como la etiqueta técnica de una lata de convertidor: arriba, una banda de rojo óxido a sangre con el nombre de la pantalla en mayúsculas anchas; abajo, sobre un fondo gris convertidor, paneles blancos que arrancan con una regla negra gruesa, como las fichas de una etiqueta. La ficha técnica manda: barras, kilos, pesos y sobra se leen de un vistazo, en números angostos y tabulares.\n\nEs una herramienta de taller para el celular, con sol fuerte y un pulgar. Por eso la densidad es alta pero ordenada (gutter de 12 px, separaciones de 6 a 10 px), los controles miden 38 a 46 px de alto y el contraste es de imprenta: casi negro sobre blanco, blanco sobre óxido. Una sola familia tipográfica (Archivo, variable en ancho) hace todo el trabajo: se ensancha para el título de la banda y se angosta para tablas y números.\n\nEl mundo reemplaza a \"Taller Táctil\": nada de panel gris con acento naranja ni de tarjetas con relieve de juguete (borde inferior duro desplazado). La profundidad es una sombra corta y suave; la estructura la dan las reglas, no los bordes.",
    "keyCharacteristics": [
      "Banda de encabezado en rojo óxido a sangre, una por pantalla.",
      "Paneles blancos sin borde perimetral, con regla de 4 px arriba.",
      "Archivo variable: ancha (110 %) en el título, angosta (80 a 88 %) en datos y títulos de panel.",
      "Números siempre tabulares; totales en una losa casi negra fija abajo.",
      "Sombra corta y suave; ninguna sombra dura desplazada.",
      "Modo oscuro completo: la regla y la tinta se invierten a casi blanco, el óxido se aclara."
    ],
    "rules": [
      {
        "name": "The Banda a Sangre Rule",
        "body": "El rojo óxido a sangre vive en una sola franja por pantalla: la banda de encabezado, de borde a borde, con margen negativo sobre el gutter. No se repite como fondo de paneles ni de secciones.",
        "section": "colors"
      },
      {
        "name": "The Un Solo Óxido Rule",
        "body": "Dentro del contenido, el óxido marca sólo lo que está elegido, lo que es la acción principal o el dato que hay que mirar (sobra). Si todo es óxido, nada es óxido.",
        "section": "colors"
      },
      {
        "name": "The Divergencia Rule",
        "body": "El contrato pedía `#4D5458` para lo secundario; el build usa `muted` para texto y deja `conv` para el gráfico de barras. Manda el build.",
        "section": "colors"
      },
      {
        "name": "The Ancho y Angosto Rule",
        "body": "Ancho por encima de 100 % sólo en el título de la banda. Todo lo que es número, medida, código de pieza o texto dentro de gráficos va angosto (80 %) y con cifras tabulares.",
        "section": "typography"
      },
      {
        "name": "The Mayúscula que Nombra Rule",
        "body": "Las mayúsculas nombran (pantalla, panel, trabajo, rótulo); nunca van en texto corrido ni en botones.",
        "section": "typography"
      },
      {
        "name": "The Sombra Corta Rule",
        "body": "Ninguna sombra desplazada y sin difuminar (\"relieve de juguete\"). Si una sombra tiene radio de desenfoque cero, está mal.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** abrir cada pantalla con la banda de rojo óxido a sangre y el título en mayúsculas anchas (900, ancho 110 %).",
      "**Do** armar paneles blancos sin borde, con regla superior de 4 px en `ink` y 6 px de radio.",
      "**Do** escribir toda cifra, medida y código de pieza en Archivo angosta (80 a 85 %) con cifras tabulares.",
      "**Do** reservar el óxido para lo elegido, la acción principal y el dato a mirar.",
      "**Do** usar sólo las sombras `--shadow` y `--lift` (y la del botón óxido); al tocar, bajar 1 px.",
      "**Do** mantener controles de 38 a 46 px de alto, al alcance del pulgar."
    ],
    "donts": [
      "**Don't** volver al relieve de juguete: nada de sombras duras desplazadas sin desenfoque bajo botones, chips o tarjetas.",
      "**Don't** poner bordes perimetrales a los paneles ni radios de 12 a 16 px.",
      "**Don't** usar el óxido como fondo de paneles o secciones fuera de la banda.",
      "**Don't** sumar una segunda familia tipográfica ni una monoespaciada: el ancho de Archivo hace ese trabajo.",
      "**Don't** usar el verde WhatsApp ni los colores de estado como acento decorativo."
    ]
  }
}